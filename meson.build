project('cmd', 'c', version: '0.1.0')

# Both personalities are built from the same sources.  COMMAND.COM is the
# classic MS-DOS variant, which additionally executes AUTOEXEC.BAT.
# Meson has no globbing, so the C sources are listed explicitly; keep this
# list in sync with the *.c files in this directory.
cmdlib_sources = files(
  'bassoc.c',
  'bbreak.c',
  'bcall.c',
  'bcd.c',
  'bcls.c',
  'bcolor.c',
  'bcopy.c',
  'bdate.c',
  'bdel.c',
  'bdir.c',
  'bdoskey.c',
  'becho.c',
  'bendlocal.c',
  'bexit.c',
  'bfor.c',
  'bftype.c',
  'bgoto.c',
  'bif.c',
  'bmd.c',
  'bmklink.c',
  'bmove.c',
  'bpath.c',
  'bpause.c',
  'bpopd.c',
  'bprompt.c',
  'bpushd.c',
  'brd.c',
  'brem.c',
  'bren.c',
  'bset.c',
  'bsetlocal.c',
  'bshift.c',
  'bstart.c',
  'btime_cmd.c',
  'btitle.c',
  'btype.c',
  'bver.c',
  'bverify.c',
  'bvol.c',
  'cdispatch.c',
  'cinterp.c',
  'cmain.c',
  'cparser.c',
  'credir.c',
  'cvars.c',
  'ii18n.c',
  'lautorun.c',
  'lenv.c',
  'lexec.c',
  'lfs.c',
  'lio.c',
  'llinenoise.c',
  'lpath.c',
  'lreadline.c',
  'lselfpath.c',
  'lsprintf_s.c',
  'lsysport.c',
  'lterm.c',
  'ltime_util.c',
  'lutil.c',
  'lwautorun.c',
  'lwenv.c',
  'lwexec.c',
  'lwfs.c',
  'lwio.c',
  'lwlineno.c',
  'lwpath.c',
  'lwreadline.c',
  'lwselfpath.c',
  'lwsprnfs.c',
  'lwsysport.c',
  'lwterm.c',
  'lwtimeut.c',
  'lwutil.c',
)

# On Windows the version-information resource is compiled in as well.
if host_machine.system() == 'windows'
  windows = import('windows')
  cmdlib_sources += windows.compile_resources('cmd.rc')
endif

executable('cmd',
  cmdlib_sources,
  name_suffix: 'exe',
)

executable('COMMAND',
  cmdlib_sources,
  name_suffix: 'COM',
  c_args: ['-DENABLE_AUTOEXEC=1'],
)
